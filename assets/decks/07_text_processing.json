{
  "id": 7,
  "name": "Text Processing & Editing",
  "description": "Search, transform, compare, and edit text from the terminal.",
  "icon": "text_fields",
  "cards": [
    {
      "prompt": "Which command searches text for a pattern?",
      "answer": "grep",
      "example": "grep \"error\" app.log",
      "type": "multiple_choice",
      "difficulty_tag": "novice"
    },
    {
      "prompt": "What does `grep -i \"error\" app.log` do?",
      "answer": "Searches case-insensitively for error.",
      "example": "grep -i \"error\" app.log",
      "type": "flip",
      "difficulty_tag": "user"
    },
    {
      "prompt": "What does `grep -r \"TODO\" src/` do?",
      "answer": "Searches recursively for TODO under src/.",
      "example": "grep -r \"TODO\" src/",
      "type": "flip",
      "difficulty_tag": "user"
    },
    {
      "prompt": "What does `grep -v \"debug\" app.log` do?",
      "answer": "Prints lines that do not contain debug.",
      "example": "grep -v \"debug\" app.log",
      "type": "flip",
      "difficulty_tag": "user"
    },
    {
      "prompt": "What does `sed 's/old/new/g' file.txt` do?",
      "answer": "Replaces every occurrence of old with new.",
      "example": "sed 's/old/new/g' file.txt",
      "type": "flip",
      "difficulty_tag": "user"
    },
    {
      "prompt": "Which command edits a file in place with sed?",
